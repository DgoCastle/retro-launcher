/* ==========================================
   VENTANA PRINCIPAL
   ========================================== */

QMainWindow {
    background-color: #f2f2f2;
}


/* ==========================================
   TITULOS
   ========================================== */

QLabel {
    color: #202020;
    font-size: 32px;
    font-weight: bold;
}


/* ==========================================
   BOTONES DE CONSOLA
   ========================================== */

QPushButton {
    background-color: #ffffff;

    color: #202020;

    border: none;
    border-radius: 16px;

    min-width: 200px;
    min-height: 120px;

    padding: 20px;

    font-size: 22px;
    font-weight: bold;
}


/* Botón cuando pasamos el mouse */

QPushButton:hover {
    background-color: #e6e6e6;
}


/* Botón cuando hacemos clic */

QPushButton:pressed {
    background-color: #d5d5d5;
}


/* ==========================================
   LISTA DE ROMS
   ========================================== */

QListWidget {
    background-color: #ffffff;

    border: none;
    border-radius: 16px;

    padding: 10px;

    color: #202020;

    font-size: 18px;
}


/* Elementos de la lista */

QListWidget::item {
    padding: 12px;
    border-radius: 10px;
}


/* Elemento seleccionado */

QListWidget::item:selected {
    background-color: #e6e6e6;
    color: #202020;
}


/* Elemento bajo el mouse */

QListWidget::item:hover {
    background-color: #f0f0f0;
}